                }
              }
            }
          }
        }
      }
    },
    "/v1/requests/{id}": {
      "get": {
        "tags": [
          "Requests"
        ],
        "summary": "Get a captured request",
        "operationId": "request",
        "parameters": [
          {
            "name": "id",
            "in": "path",
