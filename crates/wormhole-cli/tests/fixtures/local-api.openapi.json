{
  "openapi": "3.1.0",
  "info": {
    "title": "Wormhole Local API",
    "description": "Control the per-user Wormhole daemon, manage exposures, inspect requests, and diagnose local providers. Operational routes require the bearer token stored in the private runtime directory.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "0.1.1"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:52731",
      "description": "Local Wormhole daemon"
    }
  ],
  "paths": {
    "/v1/doctor": {
      "get": {
        "tags": [
          "Diagnostics"
        ],
        "summary": "Run daemon diagnostics",
        "operationId": "doctor",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DoctorCheck"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/endpoints": {
      "get": {
        "tags": [
          "Endpoints"
        ],
        "summary": "List active endpoints",
        "operationId": "endpoints",
        "parameters": [
          {
            "name": "service",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ActiveEndpoint"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/endpoints/{id}": {
      "delete": {
        "tags": [
          "Endpoints"
        ],
        "summary": "Close or forget an endpoint",
        "operationId": "delete_endpoint",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "forget",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClosedResponse"
                }
              }
            }
          },
          "502": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/interfaces": {
      "get": {
        "tags": [
