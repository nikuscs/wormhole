    "/v1/shutdown": {
      "post": {
        "tags": [
          "Daemon"
        ],
        "summary": "Shut down the daemon",
        "operationId": "shutdown",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClosedResponse"
                }
              }
            }
          }
        }
      }
