        }
      }
    },
    "/v1/openapi.json": {
      "get": {
        "tags": [
          "Documentation"
        ],
        "summary": "Download the OpenAPI document",
        "operationId": "openapi_json",
        "responses": {
          "200": {
            "description": "OpenAPI"
          }
        },
        "security": [
          {}
        ]
      }
    },
