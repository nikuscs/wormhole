    "/v1/status": {
      "get": {
        "tags": [
          "Status"
        ],
        "summary": "Get daemon status",
        "operationId": "status",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActiveEndpoint": {
        "type": "object",
        "description": "A live or recently stopped exposure.",
        "required": [
          "id",
          "service",
          "driver",
          "urls",
          "status",
          "since"
        ],
        "properties": {
          "buffered_delivered": {
            "type": "integer",
            "format": "int64",
            "description": "Number of buffered webhooks delivered in this daemon lifetime.",
            "minimum": 0
          },
          "buffered_failed": {
            "type": "integer",
            "format": "int32",
            "description": "Number quarantined at the relay when last reported.",
            "minimum": 0
          },
          "buffered_pending": {
            "type": "integer",
            "format": "int32",
            "description": "Number waiting at the relay when last reported.",
            "minimum": 0
          },
          "driver": {
            "type": "string",
            "description": "Driver registry name."
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Manager-local endpoint identifier."
          },
          "service": {
            "type": "string",
            "description": "Owning service name."
          },
          "since": {
            "type": "string",
            "format": "date-time",
            "description": "Time this status record was created."
          },
          "status": {
            "$ref": "#/components/schemas/EndpointStatus",
            "description": "Current lifecycle status."
          },
          "urls": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Public URLs currently assigned."
          }
        }
      },
      "ApiErrorBody": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiErrorDetail"
          }
        }
      },
      "ApiErrorDetail": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "BufferPolicy": {
        "type": "object",
        "description": "Limits applied to offline webhook buffering.",
        "required": [
          "max_requests",
          "max_body_bytes",
          "ttl_secs"
        ],
        "properties": {
          "max_body_bytes": {
            "type": "integer",
            "format": "int64",
            "description": "Maximum body bytes retained per request.",
            "minimum": 0
          },
          "max_requests": {
            "type": "integer",
            "format": "int32",
            "description": "Maximum buffered request count.",
            "minimum": 0
          },
          "ttl_secs": {
            "type": "integer",
            "format": "int64",
            "description": "Maximum retention time in seconds.",
            "minimum": 0
          }
        }
      },
      "CapturedHeader": {
        "type": "object",
        "description": "One redacted captured HTTP header.",
        "required": [
          "name",
          "value_b64"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "value_b64": {
            "type": "string"
          }
        }
      },
      "CapturedRequest": {
        "type": "object",
        "description": "Memory-only captured HTTP exchange.",
        "required": [
          "id",
          "bind_id",
          "method",
          "uri",
          "headers",
          "body",
          "body_truncated",
          "response_headers",
          "response_body_prefix",
          "response_body_truncated",
          "duration_ms",
          "delivery",
          "captured_at"
        ],
        "properties": {
          "bind_id": {
            "type": "string",
            "format": "uuid"
          },
          "body": {
            "type": "string"
          },
          "body_truncated": {
            "type": "boolean"
          },
          "captured_at": {
            "type": "string",
            "format": "date-time"
          },
          "delivery": {
            "type": "string"
          },
          "duration_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "endpoint_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "headers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CapturedHeader"
            }
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "method": {
            "type": "string"
          },
          "response_body_prefix": {
            "type": "string"
          },
          "response_body_truncated": {
            "type": "boolean"
          },
          "response_headers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CapturedHeader"
            }
          },
          "response_status": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "uri": {
            "type": "string"
          }
        }
      },
      "ClosedResponse": {
        "type": "object",
        "required": [
          "closed"
        ],
        "properties": {
          "closed": {
            "type": "boolean"
          }
        }
      },
      "CreateServiceRequest": {
        "type": "object",
        "required": [
          "service",
          "endpoints"
        ],
        "properties": {
          "default_remote": {
            "type": [
              "string",
              "null"
            ]
          },
          "endpoints": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EndpointSpec"
            }
          },
          "project_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "remotes": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "$ref": "#/components/schemas/Remote"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "service": {
            "$ref": "#/components/schemas/Service"
          }
        }
      },
      "DoctorCheck": {
        "type": "object",
        "description": "Structured diagnostic result rendered by Stage 05.",
        "required": [
          "name",
          "healthy",
          "detail"
        ],
        "properties": {
          "detail": {
            "type": "string",
            "description": "Human-readable detail without secrets."
          },
          "healthy": {
            "type": "boolean",
            "description": "Whether it succeeded."
          },
          "name": {
            "type": "string",
            "description": "Check name."
          }
        }
      },
      "EdgeAuth": {
        "type": "object",
        "description": "Access-control material enforced at a public HTTP edge.",
        "properties": {
          "basic": {
            "type": [
              "string",
              "null"
            ],
            "description": "Basic-auth credential in `user:password` form."
          },
          "bearer": {
            "type": [
              "string",
              "null"
            ],
            "description": "Bearer token expected in the Authorization header."
          },
          "link_key": {
            "type": [
              "string",
              "null"
            ],
            "description": "Base64-encoded HMAC key for expiring share links."
          }
        }
      },
      "EndpointSpec": {
        "type": "object",
        "description": "One desired public exposure through one driver instance.",
        "required": [
          "proto",
          "driver",
          "persist",
          "inspect"
        ],
        "properties": {
          "auth": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/EdgeAuth",
                "description": "Relay-edge authentication policy."
              }
            ]
          },
          "auto_host": {
            "type": "boolean",
            "description": "Permit the relay to suffix an automatically generated host on conflict."
          },
          "buffer": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/BufferPolicy",
                "description": "Offline HTTP buffering policy."
              }
            ]
          },
          "capture_body_max": {
            "type": "integer",
            "format": "int64",
            "description": "Maximum complete request body retained for inspection.",
            "minimum": 0
          },
          "domain": {
            "type": [
              "string",
              "null"
            ],
            "description": "Requested offered server domain."
          },
          "driver": {
            "type": "string",
            "description": "Registered driver name."
          },
          "host": {
            "type": [
              "string",
              "null"
            ],
            "description": "Requested server-owned subdomain label."
          },
          "inspect": {
            "type": "boolean",
            "description": "Capture requests for inspection."
          },
          "inspect_assets": {
            "type": "boolean",
            "description": "Include static asset requests in inspection capture."
          },
          "persist": {
            "$ref": "#/components/schemas/Persistence",
            "description": "Endpoint lifetime."
          },
          "proto": {
            "$ref": "#/components/schemas/ServiceProto",
            "description": "Public protocol, overwritten from the service by the manager."
          },
          "public_port": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
