    "/v1/requests": {
      "get": {
        "tags": [
          "Requests"
        ],
        "summary": "List captured requests",
        "operationId": "requests",
        "parameters": [
          {
            "name": "endpoint",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "limit",
