(( $+functions[_wormhole_commands] )) ||
_wormhole_commands() {
    local commands; commands=(
'http:Expose a local HTTP service' \
'tcp:Expose a local TCP service' \
'run:Run a command and expose its listening port' \
'up:Start services from wormhole.toml' \
'down:Stop project services or endpoint identifiers' \
'ls:List active endpoints' \
'status:Show daemon status' \
'inspect:Inspect one captured HTTP request' \
'requests:List or manage captured HTTP requests' \
'replay:Replay one captured request' \
'interfaces:List discovered interface aliases' \
'domains:List public domains advertised by configured Wormhole remotes' \
'relay:Deploy and manage self-hosted relay infrastructure' \
'remote:Manage named Wormhole remotes' \
'key:Manage the client identity key' \
'doctor:Run structured health checks' \
'local:Manage local hostname integration' \
'daemon:Manage the per-user daemon' \
'completions:Generate shell completions' \
'share:Create an expiring share link' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'wormhole commands' commands "$@"
}
(( $+functions[_wormhole__subcmd__completions_commands] )) ||
_wormhole__subcmd__completions_commands() {
    local commands; commands=()
    _describe -t commands 'wormhole completions commands' commands "$@"
}
(( $+functions[_wormhole__subcmd__daemon_commands] )) ||
_wormhole__subcmd__daemon_commands() {
    local commands; commands=(
'run:Run the daemon' \
'stop:Gracefully stop the daemon' \
'status:Show daemon status' \
'reload:Reload configuration without dropping live endpoints' \
'logs:Read daemon logs' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'wormhole daemon commands' commands "$@"
}
(( $+functions[_wormhole__subcmd__daemon__subcmd__help_commands] )) ||
