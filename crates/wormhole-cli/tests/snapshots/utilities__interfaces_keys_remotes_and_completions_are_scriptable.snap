---
source: crates/wormhole-cli/tests/utilities.rs
assertion_line: 72
expression: "String::from_utf8_lossy(&completions.stdout)"
---
#compdef wormhole

autoload -U is-at-least

_wormhole() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--config=[Override the global configuration file]:PATH:_files' \
'--json[Emit stable JSON instead of human-readable output]' \
'(-v --verbose)-q[Suppress nonessential diagnostics]' \
'(-v --verbose)--quiet[Suppress nonessential diagnostics]' \
'*-v[Increase diagnostic verbosity (repeat for trace logging)]' \
'*--verbose[Increase diagnostic verbosity (repeat for trace logging)]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_wormhole_commands" \
"*::: :->wormhole" \
&& ret=0
    case $state in
    (wormhole)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:wormhole-command-$line[1]:"
        case $line[1] in
            (http)
_arguments "${_arguments_options[@]}" : \
'*--endpoint=[Add a provider endpoint specification; repeat for multiple URLs]:DRIVER[:QUALIFIER]:_default' \
'--host=[Request a server-owned subdomain label]:HOST:_default' \
'--public-port=[Request a provider-side public TCP port]:PORT:_default' \
'--capture-body-max=[Maximum complete request body retained for inspection]:CAPTURE_BODY_MAX:_default' \
'--buffer=[Buffer up to this many offline requests]:COUNT:_default' \
'--retry=[Configure local delivery retries]:SPEC:_default' \
'(--auth-file)*--auth=[Configure relay-edge authentication]:POLICY:_default' \
'(--auth)--auth-file=[Read relay-edge authentication from a file]:PATH:_files' \
'--remote=[Select a named Wormhole remote]:REMOTE:_default' \
'--name=[Stable service name]:NAME:_default' \
'--config=[Override the global configuration file]:PATH:_files' \
'--persist[Keep the endpoint and reclaim its reservation after restarts]' \
'--no-inspect[Disable request inspection]' \
'--include-assets[Include static assets in request inspection]' \
'--foreground[Run the tunnel manager in this process]' \
'--json[Emit stable JSON instead of human-readable output]' \
'(-v --verbose)-q[Suppress nonessential diagnostics]' \
'(-v --verbose)--quiet[Suppress nonessential diagnostics]' \
'*-v[Increase diagnostic verbosity (repeat for trace logging)]' \
'*--verbose[Increase diagnostic verbosity (repeat for trace logging)]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
':target -- Local target\: PORT, HOST\:PORT, or ALIAS\:PORT:_default' \
&& ret=0
;;
(tcp)
_arguments "${_arguments_options[@]}" : \
'*--endpoint=[Add a provider endpoint specification; repeat for multiple URLs]:DRIVER[:QUALIFIER]:_default' \
'--host=[Request a server-owned subdomain label]:HOST:_default' \
