{
  "openapi": "3.1.0",
  "info": {
    "title": "wormholed",
    "description": "",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "0.0.0"
  },
  "paths": {
    "/v1/binds": {
      "get": {
        "tags": [],
        "operationId": "list_binds",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BindResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/binds/{id}": {
      "delete": {
        "tags": [],
        "operationId": "delete_bind",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          },
          "404": {
            "description": ""
          }
        }
      }
    },
    "/v1/keys": {
      "get": {
        "tags": [],
        "operationId": "list_keys",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/KeyResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [],
        "operationId": "authorize_key",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthorizeKeyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KeyFingerprint"
                }
              }
            }
          }
        }
      }
    },
    "/v1/keys/{fingerprint}": {
      "delete": {
        "tags": [],
        "operationId": "revoke_key",
        "parameters": [
          {
            "name": "fingerprint",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          },
          "400": {
            "description": ""
          }
        }
      }
    },
    "/v1/status": {
      "get": {
        "tags": [],
        "operationId": "status",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthorizeKeyRequest": {
        "type": "object",
        "required": [
          "public_key",
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "public_key": {
            "type": "string"
          }
        }
      },
      "BindResponse": {
        "type": "object",
        "required": [
          "id",
          "endpoint",
          "state",
          "persistent",
          "key_fingerprint",
          "authentication",
          "buffering"
        ],
        "properties": {
          "authentication": {
            "type": "boolean"
          },
          "buffering": {
            "type": "boolean"
          },
          "endpoint": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "key_fingerprint": {
            "type": "string"
          },
          "persistent": {
            "type": "boolean"
          },
          "state": {
            "type": "string"
          }
        }
      },
      "CertificateExpiry": {
        "type": "object",
        "required": [
          "domain",
          "expires_unix"
        ],
        "properties": {
          "domain": {
            "type": "string"
          },
          "expires_unix": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "KeyFingerprint": {
        "type": "object",
        "required": [
          "fingerprint"
        ],
        "properties": {
          "fingerprint": {
            "type": "string"
          }
        }
      },
      "KeyResponse": {
        "type": "object",
        "required": [
          "fingerprint",
          "name",
          "created",
          "revoked"
        ],
        "properties": {
          "created": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "revoked": {
            "type": "boolean"
          }
        }
      },
      "StatusResponse": {
        "type": "object",
        "required": [
          "uptime_seconds",
          "sessions",
          "binds",
          "streams",
          "certificate_expiries"
        ],
        "properties": {
          "binds": {
            "type": "integer",
            "minimum": 0
          },
          "certificate_error": {
            "type": [
              "string",
              "null"
            ]
          },
          "certificate_expiries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CertificateExpiry"
            }
          },
          "sessions": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "streams": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "uptime_seconds": {
            "type": "integer",
            "format": "int64"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "admin",
      "description": "Local relay administration"
    }
  ]
}
