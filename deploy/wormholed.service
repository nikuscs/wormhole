[Unit]
Description=Wormhole relay server
Documentation=https://github.com/nikuscs/wormhole
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=wormhole
StateDirectoryMode=0700
RuntimeDirectory=wormhole
RuntimeDirectoryMode=0700
ExecStart=/usr/local/bin/wormholed serve --config /etc/wormhole/wormholed.toml
Restart=on-failure
RestartSec=2s
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/wormhole
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
UMask=0077
TimeoutStopSec=35s

[Install]
WantedBy=multi-user.target
